# The smallest Podfile that builds React Native for macOS.
#
# `use_native_modules!` is deliberately absent: it shells out to the community
# CLI to discover third-party native modules, and this app has none. Leaving it
# out keeps the build independent of the JS toolchain.

require_relative '../../packages/react-native/scripts/react_native_pods'

platform :osx, min_macos_version_supported

prepare_react_native_project!

target 'HelloWorld' do
  use_react_native!(
    :path => '../../packages/react-native',
    :app_path => "#{Pod::Config.instance.installation_root}"
  )

  # The UIKit compatibility layer. macOS only, by its own podspec.
  pod 'React-UIKitCompat', :path => '../UIKitCompat'
end

post_install do |installer|
  # This wires the UIKit compatibility layer in for you -- the header search
  # path, the -include prelude, and taking two frameworks that do not exist on
  # macOS off the link line. Nothing else is needed here.
  #
  # It deliberately does not give third-party pods the shim: those get the
  # public <UIKit/UIKit.h>, which satisfies the import and declares nothing, so
  # a library that declares `UIView` itself still compiles. Re-adding the
  # prelude for every target here would undo that.
  react_native_post_install(installer, '../../packages/react-native')

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = min_macos_version_supported
    end
  end
end
